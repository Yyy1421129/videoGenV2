# Character clips and references live on GPFS. Generated shots are tracked under shots/.
project

# Third-party checkouts, including their media and git history.
repos/

# Python caches
__pycache__/
*.py[cod]

# Training weights and media, if they land in this tree later
*.mp4
*.mov
*.webm
*.mkv
*.wav
*.m4a
*.m4s
*.safetensors
*.pt
*.pth
*.ckpt
*.bin

# Archived shot videos are tracked. Training clips under project/ stay out.
!shots/**/*.mp4
!shots/**/*.wav
